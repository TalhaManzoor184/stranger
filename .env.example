# Gemini key from aistudio.google.com (needs billing for video generation)
GEMINI_API_KEY=

# Visuals: video (Gemini/Veo clips, default) | image (Gemini images + slow zoom, cheaper) | procedural (local test look, free)
VISUALS=video
# GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# VIDEO_RESOLUTION=720p
# If a video clip fails, make a Gemini image for that shot instead
FALLBACK_TO_IMAGE=true

# Voice: gemini (default) | kokoro (offline, free)
TTS_PROVIDER=gemini
# Deep narrators: Charon, Orus, Iapetus, Algenib, Rasalgethi
GEMINI_VOICE=Charon
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# KOKORO_VOICE=am_onyx

# Script writer (only after the hand-written reels in data/reels are used up)
# GEMINI_TEXT_MODEL=gemini-3.8-flash

# YouTube (OAuth client type "Desktop app"); get the refresh token with: npm run auth:youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# schedule = private now, public at PUBLISH_TIME · private = publish by hand · public = immediately
UPLOAD_MODE=schedule
PUBLISH_TIME=18:00
PUBLISH_UTC_OFFSET=5
